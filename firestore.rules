rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /hands/{handId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /publicPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid
        && request.resource.data.authorPseudo is string
        && request.resource.data.summary is string;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionCounts']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    function spotReadable(spotId) {
      let spot = get(/databases/$(database)/documents/spots/$(spotId));
      return spot.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == spot.data.authorUid);
    }

    match /spots/{spotId} {
      allow read: if resource.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == resource.data.authorUid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid
        && request.resource.data.authorPseudo is string
        && request.resource.data.question is string
        && request.resource.data.summary is string
        && request.resource.data.hand is map
        && (request.resource.data.visibility == 'public'
          || request.resource.data.visibility == 'private');
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionCounts']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;

      match /comments/{commentId} {
        allow read: if spotReadable(spotId);
        allow create: if request.auth != null
          && spotReadable(spotId)
          && request.auth.uid == request.resource.data.authorUid
          && request.resource.data.authorPseudo is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /responses/{responseUid} {
        allow read: if spotReadable(spotId);
        allow create, update: if request.auth != null
          && spotReadable(spotId)
          && request.auth.uid == responseUid
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorPseudo is string
          && request.resource.data.action in ['fold', 'call', 'raise']
          && (request.resource.data.action == 'fold'
            || (request.resource.data.amount is number && request.resource.data.amount >= 0));
        allow delete: if request.auth != null && request.auth.uid == responseUid;
      }
    }
  }
}
