rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /hands/{handId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /publicPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid
        && request.resource.data.authorPseudo is string
        && request.resource.data.summary is string;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionCounts']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    function spotReadable(spotId) {
      let spot = get(/databases/$(database)/documents/spots/$(spotId));
      return spot.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == spot.data.authorUid);
    }

    function publishedTournamentReadable(tournamentId) {
      let t = get(/databases/$(database)/documents/publishedTournaments/$(tournamentId));
      return t.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == t.data.authorUid);
    }

    match /publishedTournaments/{tournamentId} {
      allow read: if resource.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == resource.data.authorUid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid
        && request.resource.data.authorPseudo is string
        && request.resource.data.tournamentKey is string
        && request.resource.data.tournamentName is string
        && request.resource.data.summary is string
        && request.resource.data.handCount is int
        && request.resource.data.handCount > 0
        && (request.resource.data.visibility == 'public'
          || request.resource.data.visibility == 'private');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;

      match /hands/{handId} {
        allow read: if publishedTournamentReadable(tournamentId);
        allow create: if request.auth != null
          && publishedTournamentReadable(tournamentId)
          && get(/databases/$(database)/documents/publishedTournaments/$(tournamentId)).data.authorUid == request.auth.uid
          && request.resource.data.hand is map
          && request.resource.data.handStableKey is string
          && request.resource.data.label is string
          && request.resource.data.sortIndex is int;
        allow update, delete: if false;

        match /reports/{reportUid} {
          allow read: if publishedTournamentReadable(tournamentId);
          allow create, update: if request.auth != null
            && publishedTournamentReadable(tournamentId)
            && request.auth.uid == reportUid
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorPseudo is string
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 8000
            && request.resource.data.handDocId is string;
          allow delete: if request.auth != null && request.auth.uid == reportUid;
        }
      }
    }

    match /spots/{spotId} {
      allow read: if resource.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == resource.data.authorUid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authorUid
        && request.resource.data.authorPseudo is string
        && request.resource.data.question is string
        && request.resource.data.summary is string
        && request.resource.data.hand is map
        && (request.resource.data.visibility == 'public'
          || request.resource.data.visibility == 'private');
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionCounts']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;

      match /comments/{commentId} {
        allow read: if spotReadable(spotId);
        allow create: if request.auth != null
          && spotReadable(spotId)
          && request.auth.uid == request.resource.data.authorUid
          && request.resource.data.authorPseudo is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update: if request.auth != null
          && spotReadable(spotId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount'])
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount >= 0;
        allow delete: if false;
      }

      match /responses/{responseUid} {
        allow read: if spotReadable(spotId);
        allow create, update: if request.auth != null
          && spotReadable(spotId)
          && request.auth.uid == responseUid
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorPseudo is string
          && request.resource.data.action in ['fold', 'call', 'raise']
          && (request.resource.data.action == 'fold'
            || (request.resource.data.amount is number && request.resource.data.amount >= 0));
        allow delete: if request.auth != null && request.auth.uid == responseUid;
      }
    }
  }
}
